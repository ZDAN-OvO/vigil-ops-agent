# 复制为根目录 .env；该文件已被 .gitignore 忽略。完整说明见 docs/usage.md。
VIGIL_ENVIRONMENT=local
VIGIL_RUNTIME_DIR=runtime
VIGIL_LOG_LEVEL=INFO
# 独立实验 PostgreSQL；默认端口 55432，避免与宿主已有实例冲突。
# VIGIL_DATABASE_URL=postgresql://vigil:<password>@127.0.0.1:55432/vigil
# 实验集群与观测栈；kubectl 默认不读该 kubeconfig，aiops 通过此变量读。
# VIGIL_KUBECONFIG=/home/<user>/.kube/vigil-lab.yaml
# VIGIL_PROMETHEUS_URL=http://127.0.0.1:9090
# VIGIL_CLUSTER=vigil-lab
# VIGIL_NAMESPACE=vigil-shop
# 现有网关的 OpenAI 兼容端点（决策 D25）；模型别名按实际网关填写。
# VIGIL_MODEL_BASE_URL=http://127.0.0.1:3425
# VIGIL_MODEL_NAME=<alias>
# VIGIL_MODEL_API_KEY=<key>
# 告警入口；未配置 token 时 serve 拒绝启动。token 需与
# vigil-monitoring/vigil-webhook-token 一致。
# 集群经 docker 网关访问宿主机，监听地址必须是 0.0.0.0 而不是 127.0.0.1；
# 端口与 AlertManager 配置里的地址保持一致，冲突时改端口并重载配置。
# VIGIL_WEBHOOK_TOKEN=<token>
# VIGIL_WEBHOOK_HOST=0.0.0.0
# VIGIL_WEBHOOK_PORT=8091
# VIGIL_DEDUP_MINUTES=10

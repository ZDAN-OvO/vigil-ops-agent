# 复制为根目录 .env；该文件已被 .gitignore 忽略。完整说明见 docs/USAGE.md。
VIGIL_ENVIRONMENT=local
VIGIL_RUNTIME_DIR=runtime
VIGIL_LOG_LEVEL=INFO
# 独立实验 PostgreSQL；默认端口 55432，避免与宿主已有实例冲突。
# VIGIL_DATABASE_URL=postgresql://vigil:<password>@127.0.0.1:55432/vigil
# 实验集群与观测栈；kubectl 默认不读该 kubeconfig，aiops 通过此变量读。
# VIGIL_KUBECONFIG=/home/<user>/.kube/vigil-lab.yaml
# VIGIL_PROMETHEUS_URL=http://127.0.0.1:9090
# VIGIL_CLUSTER=vigil-lab
# VIGIL_NAMESPACE=vigil-shop
# 现有网关的 OpenAI 兼容端点（见 docs/adr/0010-model-gateway.md）；模型别名按实际网关填写。
# VIGIL_MODEL_BASE_URL=http://127.0.0.1:3425
# VIGIL_MODEL_NAME=<alias>
# VIGIL_MODEL_API_KEY=<key>
# 仓库内置 Skill 目录（相对仓库根目录）。
# VIGIL_SKILLS_DIR=skills
# 可选追踪：默认关闭，业务正确性不依赖追踪平台。
# VIGIL_LANGSMITH_TRACING=false
# VIGIL_LANGSMITH_API_KEY=<key>
# VIGIL_LANGSMITH_PROJECT=vigil-aiops
# VIGIL_LANGFUSE_ENABLED=false
# VIGIL_LANGFUSE_PUBLIC_KEY=<key>
# VIGIL_LANGFUSE_SECRET_KEY=<key>
# VIGIL_LANGFUSE_HOST=https://cloud.langfuse.com
# 网页固定监听 127.0.0.1。可选地址用于事件中的卡片链接。
# VIGIL_WEB_PORT=8090
# VIGIL_WEB_URL=http://127.0.0.1:8090
# 告警入口需同时配置实验网关 IP 和 Bearer 令牌。均未配置时仅启动网页。
# 令牌与 AlertManager 的 credentials_file 一致，端口与接收方 URL 一致。
# VIGIL_WEBHOOK_TOKEN=<token>
# VIGIL_WEBHOOK_HOST=172.20.0.1
# VIGIL_WEBHOOK_PORT=8091

  "components": {
    "schemas": {
      "ApprovalDecision": {
        "type": "string",
        "enum": [
          "approved",
          "rejected"
        ],
        "title": "ApprovalDecision"
      },
      "ChangeView": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To"
          },
          "sensitive": {
            "type": "boolean",
            "title": "Sensitive"
          }
        },
        "type": "object",
        "required": [
          "path",
          "from",
          "to",
          "sensitive"
        ],
        "title": "ChangeView"
      },
      "ConclusionView": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "inconclusive",
              "aborted"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "status",
          "summary"
        ],
        "title": "ConclusionView"
      },
      "ConversationView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "investigation_id": {
            "type": "string",
            "title": "Investigation Id"
          },
          "page_state": {
            "type": "string",
            "enum": [
              "investigating",
              "waiting_decision",
              "executing",
              "verifying",
              "finished",
              "interrupted",
              "needs_verification"
            ],
            "title": "Page State"
          }
        },
        "type": "object",
        "required": [
          "id",
          "finished",
          "service",
          "investigation_id",
          "page_state"
        ],
        "title": "ConversationView"
      },
      "CreateRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "service": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$|^[a-z0-9]$",
            "title": "Service"
          },
          "symptoms": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Symptoms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "service",
          "symptoms"
        ],
        "title": "CreateRequest"
      },
      "DecisionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "decision": {
            "$ref": "#/components/schemas/ApprovalDecision"
          },
          "card_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Card Hash"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "decision",
          "card_hash"
        ],
        "title": "DecisionRequest"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "EvidenceView": {
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "title": "Hypothesis Id"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "supported",
              "refuted",
              "inconclusive"
            ],
            "title": "Status"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationView"
            },
            "type": "array",
            "title": "Observations"
          }
        },
        "type": "object",
        "required": [
          "hypothesis_id",
          "statement",
          "status",
          "observations"
        ],
        "title": "EvidenceView"
      },
      "FollowupView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ],
            "title": "Status"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "proposal_id",
          "reason",
          "status",
          "resolution",
          "resolved_at"
        ],
        "title": "FollowupView"
      },
      "HypothesisView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          }
        },
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "title": "HypothesisView"
      },
      "MessageRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "content"
        ],
        "title": "MessageRequest"
      },
      "MessageView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "agent"
            ],
            "title": "Role"
          },
          "kind": {
            "type": "string",
            "enum": [
              "initial",
              "hint",
              "conclusion"
            ],
            "title": "Kind"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "delivery": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "received",
                  "delivered",
                  "unconfirmed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivery"
          },
          "delivered_round": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivered Round"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "kind",
          "content",
          "delivery",
          "delivered_round",
          "created_at"
        ],
        "title": "MessageView"
      },
      "ObservationView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "relation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "supports",
                  "refutes"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Relation"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "error"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "relation",
          "status",
          "summary"
        ],
        "title": "ObservationView"
      },
      "OutcomeView": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "send_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "not_sent",
                  "sending",
                  "sent",
                  "uncertain"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Send State"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pre_check",
                  "applying",
                  "rolling_out",
                  "verifying",
                  "done"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "not_executed_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "expired",
                  "drift",
                  "revision_changed",
                  "probe_ambiguous",
                  "baseline_unavailable",
                  "api_rejected"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Not Executed Reason"
          },
          "verification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "improved",
                  "no_improvement",
                  "worsened",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification"
          },
          "verification_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "probe_ambiguous",
                  "interrupted",
                  "template_mismatch"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Reason"
          },
          "verification_done": {
            "type": "boolean",
            "title": "Verification Done",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "proposal_id"
        ],
        "title": "OutcomeView"
      },
      "ProgressView": {
        "properties": {
          "supported_hypotheses": {
            "items": {
              "$ref": "#/components/schemas/HypothesisView"
            },
            "type": "array",
            "title": "Supported Hypotheses"
          },
          "running_tool": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolView"
              },
              {
                "type": "null"

{
  "name": "vigil-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm run types:check && tsc --noEmit",
    "types": "openapi-typescript openapi.json -o src/api.generated.ts",
    "types:check": "openapi-typescript openapi.json -o src/api.generated.ts --check"
  },
  "dependencies": {
    "antd": "5.27.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "openapi-typescript": "7.10.1",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
